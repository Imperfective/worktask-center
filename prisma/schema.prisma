// 설계서 §8 데이터 모델. requests가 현재 상태를 들고,
// request_events가 모든 변경 이력을 추가 전용(append-only)으로 쌓는다.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"        // 설계서: SQLite. Postgres 전환 시 provider/URL만 교체
  url      = env("DATABASE_URL")
}

model User {
  id          String  @id
  email       String?  @unique              // 로그인 아이디. 기존 시드 계정도 채워 둔다
  passwordHash String?                      // scrypt(N=16384) — 평문은 저장하지 않는다
  name        String
  department  String                       // IT·총무·시설·영업·디자인
  isHandler   Boolean @default(false)      // 부서로 결정된다(시설·IT·총무팀이면 담당자)
  createdAt   DateTime @default(now())
  requested   Request[] @relation("requester")
  assigned    Request[] @relation("assignee")
  events      RequestEvent[]
  follows     RequestFollower[]
  sessions    Session[]
}

// 로그인 세션. 토큰 자체가 비밀이라 서명 키가 따로 필요 없고,
// 행을 지우면 즉시 무효가 되어 로그아웃이 실제로 동작한다.
model Session {
  token     String   @id                   // 랜덤 32바이트 hex
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Request {
  id            Int      @id @default(autoincrement())   // 순번 = 요청 ID
  title         String
  description   String
  summary       String   @default("")                    // AI 한 줄 요약(읽기 전용)
  category      String
  department    String
  priority      String                                    // low·normal·high·urgent
  status        String                                    // 6개 상태 문자열
  requesterId   String
  assigneeId    String?
  duplicateOfId Int?
  holdReason    String?                                   // 상세 강조 박스용 복사본(원본은 이벤트)
  holdResumeDate String?
  result        String?                                   // 처리 내역
  rejectReason  String?
  aiSuggestion  String?                                   // JSON: title,category,urgency,urgency_reason,summary,similar_ids
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  resolvedAt    DateTime?

  requester  User  @relation("requester", fields: [requesterId], references: [id])
  assignee   User? @relation("assignee",  fields: [assigneeId],  references: [id])
  original   Request?  @relation("dup", fields: [duplicateOfId], references: [id])
  duplicates Request[] @relation("dup")
  events     RequestEvent[]
  followers  RequestFollower[]
}

model RequestEvent {
  id        Int      @id @default(autoincrement())
  requestId Int
  actorId   String
  type      String                          // CREATED·ASSIGNED·STATUS_CHANGED·PRIORITY_CHANGED·COMMENTED·FOLLOWED·AI_SUGGESTED
  payload   String                          // JSON
  createdAt DateTime @default(now())
  request   Request  @relation(fields: [requestId], references: [id])
  actor     User     @relation(fields: [actorId], references: [id])
}

model RequestFollower {
  requestId Int
  userId    String
  via       String                          // register·detail·duplicate
  createdAt DateTime @default(now())
  request   Request @relation(fields: [requestId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
  @@id([requestId, userId])
}
